# --- Site -----------------------------------------------------------------------------
ATLAS_DOMAIN=atlas.example.com
ATLAS_PUBLIC_URL=https://atlas.example.com
# This address becomes the administrator when it signs up in /cabinet.
ATLAS_ADMIN_EMAIL=you@example.com

# --- Agents ---------------------------------------------------------------------------
# Gemini free tier key from https://aistudio.google.com/apikey (used when set),
# or Claude API key. Force one with ATLAS_AI_PROVIDER=gemini|claude.
GEMINI_API_KEY=
# GEMINI_MODEL=   (default: newest available gemini-*-flash)
ANTHROPIC_API_KEY=
# Optional overrides: model, run interval and volume (cost control).
# ATLAS_MODEL=claude-opus-5-5
ATLAS_PIPELINE_INTERVAL_MINUTES=60
ATLAS_STORIES_PER_TOPIC=2
ATLAS_MAX_STORIES_PER_RUN=6
# 0 = every agent story waits for an editor in the review queue.
ATLAS_AUTO_PUBLISH=1

# --- Telegram -------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_DELIVERY=0

# --- Payments -------------------------------------------------------------------------
# Shown to advertisers who choose "invoice"; the admin confirms receipt in the cabinet.
ATLAS_MANUAL_PAYMENT_INSTRUCTIONS=Pay to USDT (TRC-20) wallet T... and quote the payment reference. We confirm within one business day.
# Crypto invoices via NOWPayments (leave empty to hide this method).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# 1 = Russian-language ads cannot be submitted without an erid token (ОРД marking).
ATLAS_REQUIRE_ERID=1

# --- Email digest (optional, Brevo) ---------------------------------------------------
BREVO_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_PUBLIC_URL=
ATLAS_EMAIL_DELIVERY=0
